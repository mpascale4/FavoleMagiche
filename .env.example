# =============================================================
# SETUP: copia questo file in .env e inserisci la tua chiave
#   cp .env.example .env   (Linux/Mac)
#   Copy-Item .env.example .env   (Windows PowerShell)
# =============================================================

# Chiave API Google Gemini (obbligatoria per la generazione favole)
# Ottienila su: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY="inserisci-qui-la-tua-chiave-gemini"

# Modalità di generazione favole:
# - client  => usa Gemini direttamente nel frontend (default attuale)
# - backend => usa un server remoto sicuro configurato sotto
VITE_GENERATION_MODE="client"

# URL base del backend remoto, usato solo se scegli la modalità backend
# Esempio: https://favole-backend.example.com
VITE_BACKEND_BASE_URL=""

